# ==============================================================================
# VoteSecure — Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ Database Configuration
# ------------------------------------------------------------------------------
# For local XAMPP/WAMP: DB_HOST=localhost or 127.0.0.1
# For Docker Compose:  DB_HOST=db
# For AWS RDS:         DB_HOST=your-rds-endpoint.amazonaws.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=aws_voting

# ------------------------------------------------------------------------------
# ⚙️ Application Settings
# ------------------------------------------------------------------------------
APP_NAME=VoteSecure
APP_URL=http://localhost/aws-voting-advanced
APP_PORT=8080

# ------------------------------------------------------------------------------
# 📧 Voter Registration Email Restriction
# ------------------------------------------------------------------------------
# Set to 'all' to accept any email address (e.g. Gmail, Yahoo, Outlook, custom).
# Or specify a domain like '@college.ac.in' or '@ngo.org' to restrict registration.
ALLOWED_EMAIL_DOMAIN=all

# ------------------------------------------------------------------------------
# 🐳 Production Docker Hub Image (Optional)
# ------------------------------------------------------------------------------
# DOCKERHUB_IMAGE=vaibhavmungal/aws-voting
# IMAGE_TAG=latest
